# 环境配置文件（复制为 .env 后按需修改）
# docker-compose 会读取并传入后端：cp env.example .env
#
# 不配置 .env 时，默认模拟模式，不跳转支付宝、不扣款。

# ========== 安全配置（生产环境必须设置）==========
# JWT 密钥：生产环境必须设置一个足够长且随机的密钥（建议至少32字符）
# 示例：openssl rand -base64 32
JWT_SECRET=your-production-jwt-secret-key-change-me

# CORS 允许的来源域名，多个域名用逗号分隔
# 生产环境应限制为实际部署的域名
# 示例：https://example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8082

# ========== 支付宝模拟模式（默认）==========
ALIPAY_MOCK=true

# ========== 真实环境 ==========
# 改为 false 并填写密钥后，创建订单将跳转支付宝收银台
# ALIPAY_MOCK=false
# ALIPAY_APP_ID=你的沙箱/正式应用ID
# ALIPAY_PRIVATE_KEY=你的应用私钥
# ALIPAY_PUBLIC_KEY=支付宝公钥
# ALIPAY_NOTIFY_URL=http://localhost:8080/api/payment/alipay/notify
# ALIPAY_RETURN_URL=http://localhost:8081/payment/result

# return-url 需指向前端支付结果页：
# 本地前端 dev: http://localhost:5173/payment/result
# Docker 用户端:  http://localhost:8081/payment/result
